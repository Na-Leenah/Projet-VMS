<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<HBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.vms.controller.DemandeFormController"
      minHeight="620">

    <!-- ══════ SIDEBAR (identique dashboard) ══════ -->
    <VBox styleClass="sidebar">
        <HBox styleClass="sidebar-brand" alignment="CENTER_LEFT" spacing="10">
            <Label text="V" style="-fx-background-color:#1e3a72;-fx-background-radius:8;
                                   -fx-text-fill:#6ab0f5;-fx-font-weight:700;-fx-font-size:16px;
                                   -fx-min-width:34;-fx-min-height:34;-fx-alignment:CENTER;"/>
            <VBox spacing="1">
                <Label styleClass="sidebar-title"    text="VMS"/>
                <Label styleClass="sidebar-subtitle" text="VOUCHER MANAGER"/>
            </VBox>
        </HBox>
        <Label styleClass="sidebar-section" text="PRINCIPAL"/>
        <Button styleClass="nav-item" maxWidth="Infinity"
                text="🏠  Tableau de bord" alignment="CENTER_LEFT"
                onAction="#onRetourDashboard"/>
        <Button styleClass="nav-item, nav-item-active" maxWidth="Infinity"
                text="📋  Demandes" alignment="CENTER_LEFT"/>
        <VBox VBox.vgrow="ALWAYS"/>
    </VBox>

    <!-- ══════ CONTENU ══════ -->
    <VBox styleClass="main-content" HBox.hgrow="ALWAYS" spacing="14">

        <!-- Topbar -->
        <HBox alignment="CENTER_LEFT">
            <VBox HBox.hgrow="ALWAYS" spacing="2">
                <Label styleClass="page-title"    text="Nouvelle demande de bons"/>
                <Label styleClass="page-subtitle" text="Saisie par l'administrateur / comptable"/>
            </VBox>
            <HBox spacing="8">
                <Button styleClass="btn-outline" text="Annuler" onAction="#onAnnuler"/>
                <Button styleClass="btn-primary" text="💾 Enregistrer la demande"
                        onAction="#onEnregistrer"/>
            </HBox>
        </HBox>

        <!-- Barre étapes -->
        <HBox styleClass="card" spacing="0" alignment="CENTER_LEFT">
            <HBox alignment="CENTER" spacing="6">
                <Label text="1" style="-fx-background-color:#1e40af;-fx-text-fill:white;
                                       -fx-background-radius:50%;-fx-min-width:22;-fx-min-height:22;
                                       -fx-alignment:CENTER;-fx-font-size:10px;-fx-font-weight:700;"/>
                <Label text="Saisie demande"
                       style="-fx-font-size:11px;-fx-text-fill:#1e40af;-fx-font-weight:600;"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS" style="-fx-background-color:#e2e8f0;-fx-max-height:1px;-fx-pref-height:1px;" maxWidth="60"/>
            <HBox alignment="CENTER" spacing="6">
                <Label text="2" style="-fx-background-color:#e2e8f0;-fx-text-fill:#64748b;
                                       -fx-background-radius:50%;-fx-min-width:22;-fx-min-height:22;
                                       -fx-alignment:CENTER;-fx-font-size:10px;"/>
                <Label text="Facturation" style="-fx-font-size:11px;-fx-text-fill:#64748b;"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS" style="-fx-background-color:#e2e8f0;-fx-max-height:1px;-fx-pref-height:1px;" maxWidth="60"/>
            <HBox alignment="CENTER" spacing="6">
                <Label text="3" style="-fx-background-color:#e2e8f0;-fx-text-fill:#64748b;
                                       -fx-background-radius:50%;-fx-min-width:22;-fx-min-height:22;
                                       -fx-alignment:CENTER;-fx-font-size:10px;"/>
                <Label text="Paiement" style="-fx-font-size:11px;-fx-text-fill:#64748b;"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS" style="-fx-background-color:#e2e8f0;-fx-max-height:1px;-fx-pref-height:1px;" maxWidth="60"/>
            <HBox alignment="CENTER" spacing="6">
                <Label text="4" style="-fx-background-color:#e2e8f0;-fx-text-fill:#64748b;
                                       -fx-background-radius:50%;-fx-min-width:22;-fx-min-height:22;
                                       -fx-alignment:CENTER;-fx-font-size:10px;"/>
                <Label text="Approbation" style="-fx-font-size:11px;-fx-text-fill:#64748b;"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS" style="-fx-background-color:#e2e8f0;-fx-max-height:1px;-fx-pref-height:1px;" maxWidth="60"/>
            <HBox alignment="CENTER" spacing="6">
                <Label text="5" style="-fx-background-color:#e2e8f0;-fx-text-fill:#64748b;
                                       -fx-background-radius:50%;-fx-min-width:22;-fx-min-height:22;
                                       -fx-alignment:CENTER;-fx-font-size:10px;"/>
                <Label text="Émission bons" style="-fx-font-size:11px;-fx-text-fill:#64748b;"/>
            </HBox>
        </HBox>

        <!-- Messages -->
        <Label fx:id="lblErreur" styleClass="label-erreur"
               text="" visible="false" managed="false" wrapText="true" maxWidth="Infinity"/>
        <Label fx:id="lblSucces"
               text="" visible="false" managed="false" wrapText="true" maxWidth="Infinity"
               style="-fx-font-size:12px;-fx-text-fill:#065f46;-fx-background-color:#d1fae5;
                      -fx-border-color:#a7f3d0;-fx-border-radius:7px;-fx-background-radius:7px;
                      -fx-padding:9 13;"/>

        <!-- ── Ligne 1 : Client + Paramètres bons ── -->
        <HBox spacing="12" VBox.vgrow="ALWAYS">

            <!-- CARTE CLIENT -->
            <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="12">
                <Label styleClass="card-title" text="Informations client"/>

                <!-- Sélecteur client existant -->
                <VBox spacing="5">
                    <Label styleClass="field-label" text="Client *"/>
                    <ComboBox fx:id="cbClient" maxWidth="Infinity"
                              styleClass="field-input"
                              promptText="-- Sélectionner un client --"/>
                </VBox>

                <!-- Checkbox nouveau client -->
                <CheckBox fx:id="cbNouveauClient"
                          text="➕  Nouveau client (saisie manuelle)"
                          styleClass="lf-checkbox"
                          onAction="#onNouveauClientToggle"/>

                <!-- Panneau saisie nouveau client -->
                <VBox fx:id="panneauNouveauClient" spacing="10">
                    <Label text="― Coordonnées du nouveau client ―"
                           style="-fx-font-size:11px;-fx-text-fill:#6b7280;"/>
                    <HBox spacing="10">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label styleClass="field-label" text="Nom *"/>
                            <TextField fx:id="txtNomClient" styleClass="field-input"
                                       promptText="Nom de famille"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label styleClass="field-label" text="Prénom"/>
                            <TextField fx:id="txtPrenomClient" styleClass="field-input"
                                       promptText="Prénom"/>
                        </VBox>
                    </HBox>
                    <VBox spacing="4">
                        <Label styleClass="field-label" text="Société / Entreprise"/>
                        <TextField fx:id="txtSocieteClient" styleClass="field-input"
                                   promptText="Nom de la société (optionnel)"/>
                    </VBox>
                    <HBox spacing="10">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label styleClass="field-label" text="Email *"/>
                            <TextField fx:id="txtEmailClient" styleClass="field-input"
                                       promptText="email@exemple.mu"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label styleClass="field-label" text="Téléphone"/>
                            <TextField fx:id="txtTelClient" styleClass="field-input"
                                       promptText="+230 5XXX XXXX"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Champs contact (lecture quand client existant) -->
                <HBox spacing="10">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label styleClass="field-label" text="Email de dispatch"/>
                        <TextField fx:id="txtEmailClient" styleClass="field-input"
                                   promptText="Rempli automatiquement"/>
                    </VBox>
                </HBox>

                <VBox spacing="4">
                    <Label styleClass="field-label" text="CC internes (séparés par virgule)"/>
                    <TextField fx:id="txtCcInternes" styleClass="field-input"
                               promptText="admin@vms.mu, direction@vms.mu"/>
                </VBox>

            </VBox>

            <!-- CARTE PARAMÈTRES BONS -->
            <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="12">
                <Label styleClass="card-title" text="Paramètres des bons"/>

                <HBox spacing="10">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label styleClass="field-label" text="Nombre de bons *"/>
                        <TextField fx:id="txtNombreBons" styleClass="field-input"
                                   promptText="Ex : 200"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label styleClass="field-label" text="Valeur unitaire (Rs) *"/>
                        <TextField fx:id="txtValeurUnitaire" styleClass="field-input"
                                   promptText="Ex : 200"/>
                    </VBox>
                </HBox>

                <VBox spacing="4">
                    <Label styleClass="field-label" text="Date d'expiration des bons *"/>
                    <DatePicker fx:id="dpDateExpiration" maxWidth="Infinity"
                                styleClass="field-input"/>
                </VBox>

                <!-- Total -->
                <HBox styleClass="card" alignment="CENTER_LEFT" spacing="0"
                      style="-fx-background-color:#eff6ff;-fx-border-color:#bfdbfe;">
                    <Label text="Montant total de la demande"
                           style="-fx-font-size:12px;-fx-text-fill:#1e40af;"
                           HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblMontantTotal" text="Rs 0"
                           style="-fx-font-size:20px;-fx-font-weight:700;-fx-text-fill:#1e40af;"/>
                </HBox>

            </VBox>

        </HBox>

        <!-- ── Ligne 2 : Référence & Notes ── -->
        <VBox styleClass="card" spacing="12">
            <Label styleClass="card-title" text="Référence &amp; notes"/>
            <HBox spacing="12">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label styleClass="field-label" text="Référence (auto-générée)"/>
                    <TextField fx:id="txtReference" styleClass="field-input"
                               editable="false"
                               style="-fx-background-color:#f1f5f9;-fx-font-family:monospace;"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label styleClass="field-label" text="Motif / Occasion"/>
                    <TextField fx:id="txtMotif" styleClass="field-input"
                               promptText="Ex : Noël 2026, Anniversaire..."/>
                </VBox>
                <VBox spacing="4" minWidth="150">
                    <Label styleClass="field-label" text="Priorité"/>
                    <ComboBox fx:id="cbPriorite" maxWidth="Infinity" styleClass="field-input"/>
                </VBox>
            </HBox>
        </VBox>

    </VBox>

</HBox>
